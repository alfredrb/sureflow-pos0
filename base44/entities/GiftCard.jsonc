{
  "name": "GiftCard",
  "type": "object",
  "properties": {
    "card_number": {
      "type": "string",
      "description": "Unique gift card number (e.g., GC-1234567890)"
    },
    "balance": {
      "type": "number",
      "description": "Current card balance"
    },
    "original_amount": {
      "type": "number",
      "description": "Original purchase amount"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the gift card was purchased"
    },
    "purchased_by_operator_id": {
      "type": "string",
      "description": "Operator who sold the gift card"
    },
    "purchased_by_operator_name": {
      "type": "string"
    },
    "register_id": {
      "type": "string",
      "description": "Register where gift card was sold"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "expired",
        "lost"
      ],
      "default": "active",
      "description": "Card status. lost = reported lost or stolen at the service desk; the balance was moved onto a replacement card and this number can no longer be tendered."
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Optional expiration date"
    },
    "replaced_by_card_number": {
      "type": "string",
      "description": "Set on a lost/stolen card \u2014 the replacement card the remaining balance was transferred onto."
    },
    "replaces_card_number": {
      "type": "string",
      "description": "Set on a replacement card \u2014 the lost/stolen card whose balance was transferred over."
    },
    "store_id": {
      "type": "string",
      "description": "Store number that issued or last serviced this card."
    },
    "transactions": {
      "type": "array",
      "description": "Transaction history for this card",
      "items": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "transaction_date": {
            "type": "string",
            "format": "date-time"
          },
          "operator_id": {
            "type": "string"
          },
          "operator_name": {
            "type": "string"
          },
          "register_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sale",
              "redemption",
              "refund",
              "reload",
              "cash_out",
              "lost_reissue"
            ],
            "description": "Type of transaction. reload = value added at the service desk; cash_out = remaining balance paid out in cash with manager approval; lost_reissue = balance moved to or from a replacement card."
          },
          "remaining_balance": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "description": "Optional detail shown in the card history (replacement card number, approving manager, reason)."
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "card_number",
    "original_amount",
    "purchase_date"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}