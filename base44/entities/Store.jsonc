{
  "name": "Store",
  "type": "object",
  "properties": {
    "store_number": {
      "type": "string",
      "description": "Unique store identifier (e.g. 001, 002). Ties records to this store via store_id."
    },
    "name": {
      "type": "string",
      "description": "Store display name"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "description": "Grouping/region for this store (e.g. 'Northeast')"
    },
    "manager_name": {
      "type": "string",
      "description": "Primary store manager name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Inactive stores are hidden from the POS and most central views"
    },
    "opened_date": {
      "type": "string",
      "format": "date"
    },
    "relay_url": {
      "type": "string",
      "description": "Base URL of the store's Local Relay VM (e.g. http://192.168.1.50:3000). On a redundant store this must be the floating VIP, not either controller's own address, so it follows the acting primary through a failover. The Infrastructure Command Center polls this URL for VM, printer, and register hardware status."
    },
    "ha_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when this store runs the redundant store-local stack: two controller boxes, each running the PXE/NFS boot server and the Local Relay together, DRBD-mirrored and fronted by a floating VIP. Only HA stores are failed over automatically by the relay health watch."
    },
    "controller_vip": {
      "type": "string",
      "description": "Floating VIP (keepalived/VRRP) shared by the controller pair, e.g. 192.168.1.50. Lanes PXE boot from this address (DHCP next-server) and the relay is reached here, so neither depends on which box is alive."
    },
    "primary_controller_host": {
      "type": "string",
      "description": "LAN address of the controller box normally holding the VIP and the DRBD primary role (e.g. 192.168.1.51)."
    },
    "secondary_controller_host": {
      "type": "string",
      "description": "LAN address of the warm standby controller box (e.g. 192.168.1.52). Holds DRBD secondary and is promoted when the primary dies."
    },
    "acting_primary": {
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ],
      "default": "primary",
      "description": "Which controller box currently holds the VIP and the DRBD primary role. Set to 'secondary' by the relay health watch when it promotes after a primary failure, and back to 'primary' by an admin failback."
    },
    "last_failover_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the store last failed over to its secondary controller."
    },
    "last_failover_reason": {
      "type": "string",
      "description": "Why the last failover happened (e.g. the relay staleness that triggered promotion)."
    },
    "failback_pending": {
      "type": "boolean",
      "default": false,
      "description": "True while the store is running on its secondary controller and has not yet been failed back. An admin performs the controlled failback once the original primary has recovered and DRBD has resynced."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "store_number",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}