{
  "name": "Store",
  "type": "object",
  "properties": {
    "store_number": {
      "type": "string",
      "description": "Unique store identifier (e.g. 001, 002). Ties records to this store via store_id."
    },
    "name": {
      "type": "string",
      "description": "Store display name"
    },
    "store_type": {
      "type": "string",
      "enum": [
        "supercenter",
        "standard",
        "express",
        "distribution",
        "support_office"
      ],
      "default": "standard",
      "description": "Class of site. support_office = a non-selling site (HQ / back office) that owns no lanes."
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "description": "Grouping/region for this store (e.g. 'Northeast')"
    },
    "manager_name": {
      "type": "string",
      "description": "Primary store manager name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Inactive stores are hidden from the POS and most central views"
    },
    "opened_date": {
      "type": "string",
      "format": "date"
    },
    "closed_on": {
      "type": "string",
      "format": "date",
      "description": "Date this store ceased trading."
    },
    "merged_into_store_number": {
      "type": "string",
      "description": "Store number this store's operations were transferred to when it closed."
    },
    "relay_url": {
      "type": "string",
      "description": "Base URL of the store's Local Relay VM. On a redundant store this must be the floating VIP."
    },
    "ha_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when this store runs the redundant controller pair."
    },
    "controller_vip": {
      "type": "string",
      "description": "Floating VIP shared by the controller pair."
    },
    "primary_controller_host": {
      "type": "string",
      "description": "LAN address of the primary controller box."
    },
    "secondary_controller_host": {
      "type": "string",
      "description": "LAN address of the warm standby controller box."
    },
    "acting_primary": {
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ],
      "default": "primary",
      "description": "Which controller box currently holds the VIP."
    },
    "last_failover_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the store last failed over."
    },
    "last_failover_reason": {
      "type": "string",
      "description": "Why the last failover happened."
    },
    "failback_pending": {
      "type": "boolean",
      "default": false,
      "description": "True while running on the secondary controller."
    },
    "blueiris_url": {
      "type": "string",
      "description": "Base URL of this store's Blue Iris server web interface as reached from the LP office (e.g. http://192.168.40.20:81). The LP Workbench builds UI3 timeline links from it, so footage opens directly in Blue Iris at the transaction's moment. Blank = no CCTV lookup for this store."
    },
    "cctv_preroll_seconds": {
      "type": "number",
      "default": 30,
      "description": "How many seconds BEFORE the event timestamp the footage link starts, so the investigator sees the customer approach rather than landing mid-transaction."
    },
    "cctv_camera_map": {
      "type": "array",
      "description": "Which Blue Iris cameras cover each register. cameras = Blue Iris camera Short Names, comma-separated (e.g. 'lane1ovh,lane1cust').",
      "items": {
        "type": "object",
        "properties": {
          "register_id": {
            "type": "string"
          },
          "cameras": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "store_number",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}