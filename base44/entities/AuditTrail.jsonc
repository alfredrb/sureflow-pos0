{
  "name": "AuditTrail",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Short label of what was done (e.g. 'Updated Store Settings', 'Updated CSM Permissions')."
    },
    "category": {
      "type": "string",
      "enum": [
        "configuration",
        "permissions",
        "system",
        "operator",
        "register",
        "other"
      ],
      "default": "configuration",
      "description": "Type of system change recorded."
    },
    "description": {
      "type": "string",
      "description": "Detailed human-readable description of the change."
    },
    "store_id": {
      "type": "string",
      "description": "Store number this change was made AGAINST \u2014 not where the admin was sitting. Blank means the change was chain-wide: it belongs to HQ and affects every store (creating a store, editing the shared catalog, changing chain policy). That distinction is the whole point of the field: a store manager must only ever see their own store's change history, and HQ needs to be able to ask 'what changed at store 002 today' without reading every other store's entries. Historical entries written before this field existed stay blank and read as Chain-Wide."
    },
    "actor_id": {
      "type": "string",
      "description": "Operator ID of the admin who performed the change."
    },
    "actor_name": {
      "type": "string",
      "description": "Display name of the admin who performed the change."
    },
    "actor_role": {
      "type": "string",
      "description": "Role of the admin who performed the change."
    },
    "page": {
      "type": "string",
      "description": "Admin page (route) where the change was made."
    },
    "changes": {
      "type": "array",
      "description": "Field-level before/after diff. from/to are stringified representations.",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "ip_address": {
      "type": "string",
      "description": "Client IP address where the change originated, if available."
    }
  },
  "required": [
    "action",
    "category"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}