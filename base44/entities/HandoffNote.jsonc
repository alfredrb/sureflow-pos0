{
  "name": "HandoffNote",
  "type": "object",
  "properties": {
    "note": {
      "type": "string",
      "description": "What the next shift needs to know or follow up on."
    },
    "store_id": {
      "type": "string",
      "description": "Store the note belongs to."
    },
    "register_id": {
      "type": "string",
      "description": "Lane the note was written at."
    },
    "author_operator_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    },
    "resolved_by_name": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "note"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}