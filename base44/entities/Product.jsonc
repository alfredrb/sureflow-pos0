{
  "name": "Product",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "cost": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "stock_qty": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discontinued"
      ],
      "default": "active"
    },
    "return_period_days": {
      "type": "number",
      "description": "Number of days within which items can be returned. 0 or blank = no restriction."
    },
    "vendor_company_id": {
      "type": "string",
      "description": "Company ID of the vendor that owns this product. Vendors can only view/edit items matching their own Company ID."
    },
    "recalled": {
      "type": "boolean",
      "default": false,
      "description": "If true, the POS blocks this item from being sold and instructs the operator to give the item to a manager."
    },
    "recall_reason": {
      "type": "string",
      "description": "Reason for the recall, shown to the cashier when the item is scanned."
    },
    "promotional": {
      "type": "boolean",
      "default": false,
      "description": "Flags this item as part of a promotional program (reserved for future promotional logic)."
    },
    "release_date": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest date/time this item can be sold. The POS blocks sale attempts before this date/time. Blank = no restriction."
    },
    "mpp_plan": {
      "type": "string",
      "enum": [
        "none",
        "wrapped",
        "case",
        "counter",
        "locked",
        "other"
      ],
      "default": "none",
      "description": "Merchandise Protection Plan applied to this item. Set from the Loss Prevention Merchandise Protection tab. wrapped = security wrap, case = behind locked case, counter = behind counter (ask staff), locked = spider wrap/locked device."
    },
    "id_required": {
      "type": "string",
      "enum": [
        "none",
        "18",
        "21"
      ],
      "default": "none",
      "description": "If set to 18 or 21, the POS prompts the cashier to verify the customer's date of birth before adding the item to the sale. Birthday must be on or before today minus the required age."
    },
    "loss_blocked": {
      "type": "boolean",
      "default": false,
      "description": "If true, the POS blocks this item from being sold because it is causing excessive return-related profit loss. Set from the Loss Prevention Claims Audit tab."
    },
    "serialized": {
      "type": "boolean",
      "default": false,
      "description": "If true, this item requires a serial number to be captured at the POS when sold, and a matching serial must be verified on any return or exchange. Each sold unit is tracked individually in the Loss Prevention Serialized Inventory workbench."
    },
    "store_id": {
      "type": "string",
      "description": "Store number this product belongs to. Blank = shared/catalog product available to all stores."
    }
  },
  "required": [
    "sku",
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}