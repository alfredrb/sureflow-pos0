{
  "name": "EODReport",
  "type": "object",
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the EOD report (YYYY-MM-DD)"
    },
    "total_transactions": {
      "type": "number",
      "description": "Total number of transactions"
    },
    "total_revenue": {
      "type": "number",
      "description": "Total revenue from all transactions"
    },
    "total_refunds": {
      "type": "number",
      "description": "Total refund amount"
    },
    "net_revenue": {
      "type": "number",
      "description": "Revenue minus refunds"
    },
    "total_items_sold": {
      "type": "number",
      "description": "Total quantity of items sold"
    },
    "category_sales": {
      "type": "object",
      "description": "Items sold by category: {category: qty}",
      "additionalProperties": {
        "type": "number"
      }
    },
    "category_revenue": {
      "type": "object",
      "description": "Revenue by category: {category: amount}",
      "additionalProperties": {
        "type": "number"
      }
    },
    "register_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "register_id": {
            "type": "string"
          },
          "register_name": {
            "type": "string"
          },
          "transactions": {
            "type": "number"
          },
          "revenue": {
            "type": "number"
          },
          "refunds": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "description": "Sales details per register"
    },
    "payment_breakdown": {
      "type": "object",
      "description": "Revenue by payment method: {method: amount}",
      "additionalProperties": {
        "type": "number"
      }
    },
    "total_robberies": {
      "type": "number",
      "description": "Total number of robbery incidents"
    },
    "total_stolen": {
      "type": "number",
      "description": "Total amount stolen in robberies"
    },
    "robbery_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "register_id": {
            "type": "string"
          },
          "operator_id": {
            "type": "string"
          },
          "operator_name": {
            "type": "string"
          },
          "amount_stolen": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "description": "Details of robbery incidents"
    },
    "cash_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "register_id": {
            "type": "string"
          },
          "register_name": {
            "type": "string"
          },
          "operator_id": {
            "type": "string"
          },
          "operator_name": {
            "type": "string"
          },
          "total_counted": {
            "type": "number"
          },
          "expected_amount": {
            "type": "number"
          },
          "discrepancy": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "description": "Cash audit records for this EOD period"
    },
    "total_audits": {
      "type": "number",
      "description": "Total number of cash audits performed"
    },
    "total_discrepancy": {
      "type": "number",
      "description": "Sum of all audit discrepancies"
    }
  },
  "required": [
    "report_date"
  ]
}