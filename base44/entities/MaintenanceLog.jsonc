{
  "name": "MaintenanceLog",
  "type": "object",
  "properties": {
    "log_type": {
      "type": "string",
      "enum": [
        "hardware_repair",
        "software_update",
        "register_service",
        "preventive",
        "other"
      ],
      "default": "hardware_repair",
      "description": "Type of maintenance work"
    },
    "register_id": {
      "type": "string",
      "description": "Register involved (if applicable)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "technician_name": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Date the work was performed or scheduled"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed"
      ],
      "default": "scheduled"
    },
    "parts_used": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Technician notes and resolution details"
    },
    "updated_by": {
      "type": "string",
      "description": "Name of the operator who last updated this log entry"
    },
    "updated_by_role": {
      "type": "string",
      "description": "Role of the operator who last updated this log entry"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this log entry was last updated"
    },
    "replaced_device": {
      "type": "string",
      "enum": [
        "none",
        "printer",
        "scanner",
        "cash_drawer",
        "terminal"
      ],
      "default": "none",
      "description": "Device being upgraded or replaced during this maintenance"
    },
    "new_model": {
      "type": "string",
      "description": "New model of the replaced device (auto-updates the register)"
    },
    "new_serial": {
      "type": "string",
      "description": "New serial number of the replaced device (auto-updates the register)"
    },
    "store_id": {
      "type": "string",
      "description": "Store number this log targets. Blank = broadcast to all stores / unassigned."
    },
    "sent_from_central": {
      "type": "boolean",
      "default": false,
      "description": "True if this maintenance notice was issued from Central Admin to stores"
    }
  },
  "required": [
    "log_type",
    "title",
    "service_date",
    "status"
  ]
}