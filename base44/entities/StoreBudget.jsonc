{
  "name": "StoreBudget",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "Budget period (YYYY-MM). One budget record per month."
    },
    "revenue_budget": {
      "type": "number",
      "default": 0,
      "description": "Target gross sales revenue (subtotal) for the month."
    },
    "cogs_budget": {
      "type": "number",
      "default": 0,
      "description": "Target cost of goods sold for the month."
    },
    "labor_budget": {
      "type": "number",
      "default": 0,
      "description": "Target labor / payroll cost for the month."
    },
    "overtime_budget": {
      "type": "number",
      "default": 0,
      "description": "Target monthly overtime PAY allowance. Reflected read-only on the Payroll Labor Budget & Overtime section and compared against actual overtime pay."
    },
    "loss_budget": {
      "type": "number",
      "default": 0,
      "description": "Expected / acceptable profit loss (disposed returns, claims) for the month."
    },
    "expenses_budget": {
      "type": "number",
      "default": 0,
      "description": "Target other operating expenses for the month (rent, utilities, supplies, etc.)."
    },
    "weekly_hours_budget": {
      "type": "number",
      "default": 0,
      "description": "Target labor hours per week. Drives the Weekly Hours Budget target on the shift scheduling page (reflects back from the Financials Store Budget)."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "month"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}