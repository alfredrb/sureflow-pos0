{
  "name": "CashAdvance",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Register ID receiving the advance"
    },
    "register_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Amount of cash advanced"
    },
    "bills": {
      "type": "object",
      "description": "Bill counts dispensed with this advance, for reconciliation and the printed slip's denomination block. Optional \u2014 an amount-only advance leaves this blank.",
      "properties": {
        "hundred": {
          "type": "number"
        },
        "fifty": {
          "type": "number"
        },
        "twenty": {
          "type": "number"
        },
        "ten": {
          "type": "number"
        },
        "five": {
          "type": "number"
        },
        "two": {
          "type": "number"
        },
        "one": {
          "type": "number"
        }
      }
    },
    "reason": {
      "type": "string",
      "description": "Reason for the cash advance"
    },
    "approved_by_id": {
      "type": "string",
      "description": "User ID who approved the advance"
    },
    "approved_by_name": {
      "type": "string",
      "description": "Name of user who approved the advance"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "withdrawn"
      ],
      "default": "pending",
      "description": "Status of the cash advance"
    }
  },
  "required": [
    "register_id",
    "amount"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}