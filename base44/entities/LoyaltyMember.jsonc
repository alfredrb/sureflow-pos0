{
  "name": "LoyaltyMember",
  "type": "object",
  "properties": {
    "loyalty_id": {
      "type": "string",
      "description": "Unique loyalty ID (e.g. LY-XXXXXXXX)"
    },
    "name": {
      "type": "string",
      "description": "Customer full name"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "rewards_balance": {
      "type": "number",
      "default": 0,
      "description": "Spendable rewards credit in store currency"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "Total rewards ever earned by this member"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Disabled members cannot earn or redeem at the POS"
    },
    "enrolled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the member was enrolled"
    },
    "enrolled_by_operator_id": {
      "type": "string",
      "description": "Operator who enrolled the member"
    },
    "enrolled_by_operator_name": {
      "type": "string"
    },
    "enrolled_at_register": {
      "type": "string",
      "description": "Register ID where the member was enrolled"
    },
    "consent_on_pinpad": {
      "type": "boolean",
      "default": false,
      "description": "True when THIS CUSTOMER agreed to the loyalty terms themselves on the lane's customer-facing pinpad, rather than the cashier ticking a box on their behalf. That distinction is the whole point of the field: it is a customer-attested consent, so a marketing-contact dispute can be answered with the customer's own action at the pad. False on a lane with no pinpad, where enrolment stays cashier-entered."
    },
    "consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer confirmed the loyalty terms on the pinpad. Blank when no pad consent was captured."
    },
    "phone_from_pinpad": {
      "type": "boolean",
      "default": false,
      "description": "True when the phone number was keyed by the customer on the pinpad and confirmed by them, rather than read aloud and typed by the cashier. A pad-keyed number is materially more trustworthy for later lookups, so it is worth knowing which it was."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "loyalty_id",
    "name",
    "rewards_balance",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}