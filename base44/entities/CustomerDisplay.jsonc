{
  "name": "CustomerDisplay",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Store number this slide belongs to. Blank = shown at every store (a chain-wide slide)."
    },
    "headline": {
      "type": "string",
      "description": "Large primary line on the slide (e.g. 'Save 20% on Otterbox cases')."
    },
    "subtext": {
      "type": "string",
      "description": "Smaller supporting line under the headline. Optional."
    },
    "image_url": {
      "type": "string",
      "description": "Full-bleed background image for this slide. Optional \u2014 a slide with no image renders as type on the brand background."
    },
    "display_seconds": {
      "type": "number",
      "default": 8,
      "description": "How long this slide holds before crossfading to the next one in the rotation."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Position in the idle rotation, lowest first."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive slides stay in the library but are skipped by the rotation."
    },
    "updated_by": {
      "type": "string",
      "description": "Admin who last saved this slide."
    }
  },
  "required": [
    "headline"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}