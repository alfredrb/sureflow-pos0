{
  "name": "CashAudit",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string"
    },
    "register_name": {
      "type": "string"
    },
    "operator_id": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "total_counted": {
      "type": "number",
      "description": "Total cash counted in the drawer"
    },
    "expected_amount": {
      "type": "number",
      "description": "Expected cash from transactions and previous balance"
    },
    "discrepancy": {
      "type": "number",
      "description": "Difference: counted - expected (positive=over, negative=short)"
    },
    "discrepancy_percentage": {
      "type": "number",
      "description": "Discrepancy as percentage of expected"
    },
    "denominations": {
      "type": "object",
      "description": "Breakdown by coin/bill: {denomination: count}",
      "additionalProperties": {
        "type": "number"
      }
    },
    "audit_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "acknowledged",
        "reviewed",
        "resolved"
      ],
      "default": "pending",
      "description": "Status of the audit alert"
    },
    "triggered_by_cash_limit": {
      "type": "boolean",
      "default": false,
      "description": "Whether this audit was triggered by exceeding cash limit"
    },
    "register_cash_limit": {
      "type": "number",
      "description": "The register's cash limit at time of audit"
    }
  },
  "required": [
    "register_id",
    "operator_id",
    "total_counted",
    "audit_date"
  ]
}