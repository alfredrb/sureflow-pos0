{
  "name": "ReceiptConfig",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string"
    },
    "store_address": {
      "type": "string"
    },
    "store_phone": {
      "type": "string"
    },
    "header_line_1": {
      "type": "string"
    },
    "header_line_2": {
      "type": "string"
    },
    "footer_line_1": {
      "type": "string"
    },
    "footer_line_2": {
      "type": "string"
    },
    "show_operator_name": {
      "type": "boolean",
      "default": true
    },
    "show_date_time": {
      "type": "boolean",
      "default": true
    },
    "show_register_id": {
      "type": "boolean",
      "default": true
    },
    "show_tax_breakdown": {
      "type": "boolean",
      "default": true
    },
    "show_barcode": {
      "type": "boolean",
      "default": false
    },
    "show_discounts": {
      "type": "boolean",
      "default": true,
      "description": "Show discount details on receipts"
    }
  },
  "required": [
    "store_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}