{
  "name": "RelayCredential",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Store number this relay credential belongs to. One active credential per store."
    },
    "api_key": {
      "type": "string",
      "description": "Per-store shared secret the Local Relay VM presents to the relaySync cloud endpoint. Generated in the Infrastructure Command Center and pasted into the relay's .env as CLOUD_API_KEY."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Revoked keys are rejected by the sync endpoint."
    },
    "generated_by": {
      "type": "string",
      "description": "Admin who generated this credential."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the relay successfully authenticated with this key."
    }
  },
  "required": [
    "store_id",
    "api_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}