{
  "name": "RelayCredential",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Store number this relay credential belongs to. One active credential per store."
    },
    "api_key": {
      "type": "string",
      "description": "Per-store shared secret the Local Relay VM presents to the relaySync cloud endpoint. Generated in the Infrastructure Command Center and pasted into the relay's .env as CLOUD_API_KEY."
    },
    "access_token": {
      "type": "string",
      "description": "The relay's own RELAY_ACCESS_TOKEN \u2014 the secret that gates its privileged routes (reboot, backup, self-update, lane reboot). Held here server-side and forwarded as X-Relay-Token by the relayProxy function, so the cloud portal can command a plain-HTTP relay without the token ever living in a browser."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Revoked keys are rejected by the sync endpoint, and revoking also cuts the portal's proxied operations off from that store's relay."
    },
    "generated_by": {
      "type": "string",
      "description": "Admin who generated this credential."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this credential was used successfully \u2014 either the relay authenticating with the sync endpoint, or the portal reaching the relay through the proxy."
    }
  },
  "required": [
    "store_id",
    "api_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}