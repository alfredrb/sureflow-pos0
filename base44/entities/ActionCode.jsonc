{
  "name": "ActionCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "number",
      "description": "Numeric action code the operator types on the POS before pressing the Action Code key (e.g. 250). Unique per store_id."
    },
    "label": {
      "type": "string",
      "description": "Operator-facing name of the action code, shown on the POS confirmation and in the admin table."
    },
    "action": {
      "type": "string",
      "enum": [
        "void_item",
        "abort_transaction",
        "void_cash_transaction",
        "void_transaction",
        "discount_item",
        "discount_total",
        "discount_percent",
        "price_check",
        "no_sale",
        "subtotal",
        "tax_exempt",
        "price_override",
        "quantity",
        "repeat_last",
        "suspend",
        "resume",
        "transfer_out",
        "transfer_in",
        "refund",
        "reprint_receipt",
        "cash_management",
        "request_cash_pickup",
        "request_cash_advance",
        "till_count",
        "training_mode",
        "diagnostics",
        "print_test_slip",
        "csm_help",
        "csm_need",
        "age_verify",
        "report_robbery",
        "item_list",
        "loyalty_lookup",
        "export_cash",
        "supervisor_override",
        "csm_approval",
        "print_config",
        "register_tender_reading",
        "eod_summary",
        "none"
      ],
      "default": "none",
      "description": "POS function this code dispatches to. Mirrors the FunctionKey action set plus POS-level actions reachable only by code. abort_transaction clears the in-progress sale before tender (formerly void_transaction, which is kept as a legacy alias). void_cash_transaction pulls a COMPLETED cash sale back out of the books \u2014 manager approval, current shift only, cash tender only. csm_approval turns the lane's virtual CSM key on/off \u2014 while on, CSM-level actions run without a per-action PIN. print_config prints the lane's configuration / hardware profile slip for technicians. register_tender_reading prompts for a register and prints that register's reading slip \u2014 SOD opening balances, the live current running totals and the consolidated EOD figures, broken down by tender. eod_summary shows the store's consolidated end-of-day summary on the lane's customer pinpad and prints it for the record. discount_percent takes a percentage off the whole sale \u2014 a fixed percent from action_param, or prompts the operator when action_param is blank. csm_need pages the CSM with the specific need in action_param (NEED CHANGE, LONG LINES, NEED BAGS\u2026) instead of a generic help request. till_count prints the expected drawer contents so the operator can count against it mid-shift. print_test_slip prints a printer/station test pattern for technicians. age_verify opens a standalone ID check with the minimum age in action_param. transfer_out parks the live sale for pickup on another lane and prints a barcoded transfer slip; transfer_in pulls that sale onto this lane and carries on ringing it."
    },
    "action_param": {
      "type": "string",
      "description": "Optional value passed to the action, letting one action back many codes. discount_percent = the percentage (e.g. '10'; blank prompts the operator). csm_need = the need text shown to the CSM (e.g. 'NEED CHANGE'). age_verify = the minimum age ('18' or '21'). Ignored by actions that take no parameter."
    },
    "requires_role": {
      "type": "string",
      "enum": [
        "none",
        "csm",
        "manager"
      ],
      "default": "none",
      "description": "Minimum role required to run this code without a supervisor override. Gated through the same POS override/PIN flow as function keys."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "placeholder",
        "inactive"
      ],
      "default": "active",
      "description": "active = dispatches normally; placeholder = recognized but shows 'coming soon' (feature not built yet); inactive = kept as reference only, treated as not supported."
    },
    "store_id": {
      "type": "string",
      "description": "Store number this code mapping applies to. Blank = global default used by every store that has no store-specific override for the same code."
    },
    "notes": {
      "type": "string",
      "description": "Reference notes for technicians (original 4690/Walmart action code name, quirks, why it is unmapped)."
    }
  },
  "required": [
    "code",
    "label",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}