{
  "name": "RegisterLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "login",
        "logout",
        "override",
        "transaction",
        "void",
        "no_sale",
        "register_change",
        "robbery",
        "cash_request",
        "drawer_open"
      ],
      "description": "Type of event logged. drawer_open = one cash drawer open instance on the lane, read from the printer's drawer-sense line. Exactly one record per open: written when it passes the alarm threshold and finalized with the real duration when it closes."
    },
    "operator_id": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "operator_role": {
      "type": "string"
    },
    "register_id": {
      "type": "string"
    },
    "register_name": {
      "type": "string"
    },
    "detail": {
      "type": "string",
      "description": "Human-readable detail about the event"
    },
    "drawer_open_seconds": {
      "type": "number",
      "description": "How long the cash drawer stood open, in seconds, for a drawer_open event. Written when the drawer closes, so it is the real duration rather than the moment the alarm threshold was crossed."
    },
    "drawer_reason": {
      "type": "string",
      "enum": [
        "sale",
        "no_sale",
        "cash_management",
        "till",
        "customer_service",
        "manual"
      ],
      "description": "What released the drawer. manual = nothing in the POS claimed it, which is the unexplained open Loss Prevention cares about."
    },
    "drawer_no_sale": {
      "type": "boolean",
      "default": false,
      "description": "True when the drawer opened with no operator action accounting for it. This is the till-skim signature the Drawer Activity report ranks operators on."
    },
    "transaction_id": {
      "type": "string",
      "description": "Linked transaction ID if applicable"
    },
    "transaction_total": {
      "type": "number",
      "description": "Transaction amount if applicable"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Whether a cash_request alert has been acknowledged by an admin"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "discount_type": {
            "type": "string"
          },
          "discount_percentage": {
            "type": "number"
          },
          "original_price": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "description": "Transaction items with discount details"
    },
    "override_operator_id": {
      "type": "string"
    },
    "override_operator_name": {
      "type": "string"
    },
    "override_action": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "operator_id",
    "register_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}