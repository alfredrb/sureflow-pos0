{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Unique employee ID (e.g. EMP-001)."
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "position": {
      "type": "string",
      "description": "Job title / position."
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "operator_id": {
      "type": "string",
      "description": "Operator ID of the operator automatically created for this employee."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "full_name",
    "status"
  ]
}