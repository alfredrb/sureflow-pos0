{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Unique employee ID (e.g. EMP-001)."
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "position": {
      "type": "string",
      "description": "Job title / position."
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "on_leave",
        "terminated"
      ],
      "default": "active",
      "description": "Employment status. on_leave disables the linked operator for the duration; terminated disables the operator and starts a 30-day rehire window (unless blacklisted)."
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "operator_id": {
      "type": "string",
      "description": "Operator ID of the operator automatically created for this employee."
    },
    "leave_start": {
      "type": "string",
      "format": "date",
      "description": "First day of an active leave."
    },
    "leave_end": {
      "type": "string",
      "format": "date",
      "description": "Scheduled last day of leave. The operator is re-enabled when the employee is reactivated."
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Date the employee was terminated."
    },
    "termination_reason": {
      "type": "string",
      "enum": [
        "voluntary",
        "layoff",
        "poor_performance",
        "end_of_contract",
        "gross_misconduct",
        "other"
      ],
      "description": "Reason for termination. gross_misconduct blacklists the employee from rehire."
    },
    "rehire_eligible": {
      "type": "boolean",
      "default": true,
      "description": "Whether the employee is eligible for rehire. Set false on gross misconduct termination."
    },
    "rehire_eligible_date": {
      "type": "string",
      "format": "date",
      "description": "Last day the employee is eligible for rehire (termination date + 30 days). Null when blacklisted."
    },
    "blacklisted": {
      "type": "boolean",
      "default": false,
      "description": "True when the employee is blacklisted from rehire (gross misconduct). Can be cleared manually."
    },
    "last_action_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent HR status action was performed."
    },
    "last_action_by": {
      "type": "string",
      "description": "Operator who performed the most recent HR action."
    },
    "last_action_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "full_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}