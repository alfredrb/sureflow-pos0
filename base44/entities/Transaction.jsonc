{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the sale occurred. Set by the POS at sale time; for historical/mock data this carries the real sale time (the built-in created_date reflects record insertion and cannot be backdated). Peak-time forecasting and historical analytics use this field, falling back to created_date."
    },
    "operator_id": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "register_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit",
        "debit",
        "check",
        "store_credit",
        "giftcard",
        "rewards"
      ],
      "default": "cash",
      "description": "Primary tender on the sale \u2014 the largest tender when the sale was split. Kept as the single-value field every report, EOD roll-up and the cash-void path reads. See tenders for the full breakdown."
    },
    "tenders": {
      "type": "array",
      "description": "Every tender applied to this sale, in the order the operator committed them. A single-tender sale has one entry. The amounts always sum to the total due plus any cash overpayment (which becomes change_due).",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "credit",
              "debit",
              "check",
              "store_credit",
              "giftcard",
              "rewards"
            ],
            "description": "Tender type for this portion of the payment."
          },
          "amount": {
            "type": "number",
            "description": "Amount applied on this tender. For cash this may exceed the remaining balance, producing change."
          },
          "reference": {
            "type": "string",
            "description": "Optional tender reference \u2014 check number, gift card number, or auth code."
          }
        }
      }
    },
    "split_tender": {
      "type": "boolean",
      "default": false,
      "description": "True when more than one tender was applied to the sale. Lets reports flag split payments without inspecting the tenders array."
    },
    "giftcard_number": {
      "type": "string",
      "description": "Gift card number if payment_method is giftcard"
    },
    "customer_rating": {
      "type": "number",
      "description": "Customer's 1\u20135 satisfaction rating, tapped on the lane's customer-facing pinpad after the sale completed. Blank = the customer did not rate the visit (no pinpad, walked away, or timed out)."
    },
    "rating_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer rating was captured on the pinpad."
    },
    "training_mode": {
      "type": "boolean",
      "default": false,
      "description": "Whether this transaction was in training mode and not recorded in financial logs"
    },
    "offline_capture": {
      "type": "boolean",
      "default": false,
      "description": "True when the sale was captured on a store's Local Relay VM while its internet connection was down, then uploaded to the cloud by the relay sync worker. Offline sales are cash/check only."
    },
    "tax_exempt_id": {
      "type": "string",
      "description": "Tax Exempt ID verified at the POS that removed tax from this sale"
    },
    "loyalty_id": {
      "type": "string",
      "description": "Loyalty member ID linked to this sale"
    },
    "loyalty_member_name": {
      "type": "string",
      "description": "Name of the loyalty member at time of sale"
    },
    "rewards_earned": {
      "type": "number",
      "default": 0,
      "description": "Rewards credit earned by the member on this sale"
    },
    "rewards_applied": {
      "type": "number",
      "default": 0,
      "description": "Rewards credit redeemed (applied as tender) on this sale"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer ID recorded for no-receipt returns and manager override returns."
    },
    "no_receipt": {
      "type": "boolean",
      "default": false,
      "description": "True for no-receipt returns \u2014 a customer ID was required and recorded. Tracked by the Loss Prevention no-receipt returns panel."
    },
    "manager_override_return": {
      "type": "boolean",
      "default": false,
      "description": "True for Manager Override Returns \u2014 acts as a no-receipt return authorized by a manager. Logged in the LP workbench."
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "voided",
        "refunded",
        "exchanged"
      ],
      "default": "completed",
      "description": "voided = a completed cash sale pulled back out of the books by a manager-approved cash void. Voided sales are excluded from revenue, EOD and all financial roll-ups but retained for Loss Prevention."
    },
    "voided_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cash void was performed at the register."
    },
    "voided_by_operator_id": {
      "type": "string",
      "description": "Operator who ran the cash void."
    },
    "voided_by_operator_name": {
      "type": "string"
    },
    "void_approved_by_operator_id": {
      "type": "string",
      "description": "Manager who approved the cash void (the slip's APPROVED BY signature)."
    },
    "void_approved_by_operator_name": {
      "type": "string"
    },
    "void_reason": {
      "type": "string",
      "description": "Reason the sale was voided, entered at the register and printed on the void slip."
    },
    "refund_type": {
      "type": "string",
      "enum": [
        "partial",
        "total",
        "exchange"
      ],
      "description": "Set on refunded/exchanged transactions"
    },
    "refunded_skus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy: SKUs fully refunded"
    },
    "refunded_qty": {
      "type": "object",
      "description": "Map of sku -> qty already refunded from this transaction",
      "additionalProperties": {
        "type": "number"
      }
    },
    "amount_tendered": {
      "type": "number"
    },
    "change_due": {
      "type": "number"
    },
    "override_operator_id": {
      "type": "string",
      "description": "Operator who approved a return-period override"
    },
    "override_operator_name": {
      "type": "string",
      "description": "Name of operator who approved a return-period override"
    },
    "shift_id": {
      "type": "string",
      "description": "Shift record ID for tracking who was on duty"
    },
    "shift_status": {
      "type": "string",
      "enum": [
        "on_shift",
        "on_break",
        "on_lunch",
        "overtime"
      ],
      "description": "Operator's shift status during transaction"
    },
    "store_id": {
      "type": "string",
      "description": "Store number this sale belongs to (copied from the register at sale time)"
    }
  },
  "required": [
    "transaction_id",
    "operator_id",
    "register_id",
    "total"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}