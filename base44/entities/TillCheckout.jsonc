{
  "name": "TillCheckout",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Register ID for this till"
    },
    "register_name": {
      "type": "string",
      "description": "Register name"
    },
    "bag_number": {
      "type": "string",
      "description": "Bag number assigned to this till at check-out. Keyed again at check-in and must match, which is what ties the cash that left the safe to the cash that came back. Any value is allowed, including '0' for a loose till with no bag label."
    },
    "operator_id": {
      "type": "string",
      "description": "Operator who checked out the till"
    },
    "operator_name": {
      "type": "string",
      "description": "Operator name"
    },
    "checkin_operator_id": {
      "type": "string",
      "description": "Operator who checked the till back in. Recorded separately from the check-out operator so reconciliation can answer who pulled the bag and who returned it."
    },
    "checkin_operator_name": {
      "type": "string",
      "description": "Name of the operator who checked the till back in."
    },
    "checkout_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the till was checked out"
    },
    "checkin_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the till was checked in"
    },
    "status": {
      "type": "string",
      "enum": [
        "checked_out",
        "checked_in"
      ],
      "default": "checked_out",
      "description": "Current status of the till"
    },
    "forced": {
      "type": "boolean",
      "default": false,
      "description": "True when this till was checked in with a bag number that did not match the check-out, using the manager force override."
    },
    "force_manager_id": {
      "type": "string",
      "description": "Operator ID of the manager who authorized the forced check-in."
    },
    "force_manager_name": {
      "type": "string",
      "description": "Name of the manager who authorized the forced check-in."
    },
    "force_reason": {
      "type": "string",
      "description": "Why the bag-number mismatch was overridden (wrong bag pulled, label unreadable, and so on). Required by the UI when forcing."
    },
    "expected_bag_number": {
      "type": "string",
      "description": "Bag number the open check-out expected, kept alongside the keyed one so a mismatch stays legible after the fact."
    },
    "checkout_bills": {
      "type": "object",
      "description": "Bills provided at checkout",
      "properties": {
        "twenty": {
          "type": "number",
          "default": 5
        },
        "ten": {
          "type": "number",
          "default": 5
        },
        "five": {
          "type": "number",
          "default": 10
        },
        "one": {
          "type": "number",
          "default": 40
        }
      }
    },
    "checkout_coins": {
      "type": "object",
      "description": "Coins provided at checkout",
      "properties": {
        "quarters_rolls": {
          "type": "number",
          "default": 2
        },
        "dimes_rolls": {
          "type": "number",
          "default": 1
        },
        "nickels_rolls": {
          "type": "number",
          "default": 1
        },
        "pennies_rolls": {
          "type": "number",
          "default": 2
        }
      }
    },
    "checkout_total": {
      "type": "number",
      "description": "Total value of till at checkout ($250)"
    },
    "checkin_bills": {
      "type": "object",
      "description": "Bills returned at checkin. Includes $100 bills taken over the day even though the standard checkout float carries none.",
      "properties": {
        "hundred": {
          "type": "number"
        },
        "twenty": {
          "type": "number"
        },
        "ten": {
          "type": "number"
        },
        "five": {
          "type": "number"
        },
        "one": {
          "type": "number"
        }
      }
    },
    "checkin_coins": {
      "type": "object",
      "description": "Coins returned at checkin",
      "properties": {
        "quarters_rolls": {
          "type": "number"
        },
        "dimes_rolls": {
          "type": "number"
        },
        "nickels_rolls": {
          "type": "number"
        },
        "pennies_rolls": {
          "type": "number"
        }
      }
    },
    "checkin_total": {
      "type": "number",
      "description": "Total value of till at checkin"
    },
    "discrepancy": {
      "type": "number",
      "description": "Difference between checkout and checkin amounts"
    },
    "notes": {
      "type": "string",
      "description": "Any notes about the till"
    }
  },
  "required": [
    "register_id",
    "operator_id",
    "checkout_date"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}