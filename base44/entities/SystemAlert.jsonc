{
  "name": "SystemAlert",
  "type": "object",
  "properties": {
    "alert_type": {
      "type": "string",
      "enum": [
        "hardware",
        "sync",
        "inventory",
        "security",
        "network",
        "other"
      ],
      "default": "hardware",
      "description": "Category of system alert"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "warning"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Register ID or 'System' origin"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved"
      ],
      "default": "active"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this alert was last emailed to the ops notification list. Blank = never notified. The dispatcher reads this so the same alert is not re-sent on every pass."
    },
    "notify_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this alert has been emailed. Used with the re-notify window so a store that is down all weekend produces a handful of reminders rather than hundreds."
    },
    "recovery_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 'recovered' email was sent after this alert resolved. Only alerts that were actually notified get a recovery email, so the inbox tells a complete story."
    }
  },
  "required": [
    "alert_type",
    "severity",
    "title",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}