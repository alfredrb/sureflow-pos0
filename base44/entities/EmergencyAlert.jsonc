{
  "name": "EmergencyAlert",
  "type": "object",
  "properties": {
    "alert_type": {
      "type": "string",
      "enum": [
        "robbery"
      ],
      "description": "Type of emergency alert"
    },
    "register_id": {
      "type": "string",
      "description": "Register where alert was triggered"
    },
    "register_name": {
      "type": "string",
      "description": "Register name/location"
    },
    "operator_id": {
      "type": "string",
      "description": "Operator on duty"
    },
    "operator_name": {
      "type": "string",
      "description": "Operator name"
    },
    "operator_role": {
      "type": "string",
      "description": "Operator role"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the alert was triggered"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved"
      ],
      "default": "active",
      "description": "Status of the alert"
    },
    "acknowledged_by_id": {
      "type": "string",
      "description": "Admin who acknowledged the alert"
    },
    "acknowledged_by_name": {
      "type": "string",
      "description": "Name of admin who acknowledged"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When alert was acknowledged"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "True when the alert has been archived (manually or automatically after 30 days). Archived alerts are hidden from the active log and kept in a separate archived section."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the alert was archived."
    },
    "archived_by_id": {
      "type": "string",
      "description": "Operator who archived the alert. Blank when auto-archived."
    },
    "archived_by_name": {
      "type": "string",
      "description": "Name of the operator who archived the alert, or 'System' for auto-archive."
    },
    "archived_automatically": {
      "type": "boolean",
      "default": false,
      "description": "True if archived by the 30-day automatic archive rule rather than a manual action."
    }
  },
  "required": [
    "alert_type",
    "register_id",
    "operator_id",
    "timestamp"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}