{
  "name": "Operator",
  "type": "object",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Unique operator login ID"
    },
    "full_name": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "description": "Login PIN"
    },
    "role": {
      "type": "string",
      "enum": [
        "cashier",
        "csm",
        "manager",
        "technician"
      ],
      "default": "cashier",
      "description": "Technician role: POS access in locked Training Mode with diagnostics tools; admin access limited to Registers, Network, Hardware Status, and Maintenance Log."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "email": {
      "type": "string"
    },
    "store_id": {
      "type": "string",
      "description": "Store number this operator is assigned to. Blank = unassigned (visible centrally)."
    }
  },
  "required": [
    "operator_id",
    "full_name",
    "pin",
    "role"
  ]
}