{
  "name": "Operator",
  "type": "object",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Unique operator login ID"
    },
    "full_name": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "description": "Login PIN"
    },
    "role": {
      "type": "string",
      "enum": [
        "cashier",
        "csm",
        "manager",
        "technician",
        "loss_prevention",
        "vendor"
      ],
      "default": "cashier",
      "description": "Technician role: POS access in locked Training Mode with diagnostics tools; admin access limited to Registers, Network, Hardware Status, and Maintenance Log. Loss Prevention role: admin-only access to logs, transactions, and the Loss Prevention workbench; no POS access. Vendor role: admin access limited to Inventory (own items) and Vendor Insights; no POS access."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "on_leave": {
      "type": "boolean",
      "default": false,
      "description": "True when the linked employee is on leave. Displayed as an On Leave badge in Operator Management. While on leave the operator status is set to inactive."
    },
    "email": {
      "type": "string"
    },
    "store_id": {
      "type": "string",
      "description": "Store number this operator is assigned to. Blank = unassigned (visible centrally)."
    },
    "pos_access": {
      "type": "boolean",
      "default": true,
      "description": "If false, this operator cannot log into the POS or approve POS overrides."
    },
    "company_id": {
      "type": "string",
      "description": "For vendor role: the Company ID this operator represents. Used to scope inventory and sales insights to only items tagged with this Company ID."
    }
  },
  "required": [
    "operator_id",
    "full_name",
    "pin",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}