{
  "name": "Operator",
  "type": "object",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Unique operator login ID"
    },
    "full_name": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "description": "Login PIN"
    },
    "role": {
      "type": "string",
      "enum": [
        "cashier",
        "csm",
        "manager",
        "technician",
        "loss_prevention",
        "vendor"
      ],
      "default": "cashier",
      "description": "POS-side role. Governs what this person can do at the register (tender keys, overrides, training-mode diagnostics) and nothing else. Admin-panel access is governed separately by admin_role, because the same person needs different permissions on the two surfaces."
    },
    "admin_role": {
      "type": "string",
      "enum": [
        "none",
        "hq_admin",
        "store_manager",
        "csm",
        "lp",
        "technician",
        "vendor"
      ],
      "description": "Admin-panel role, deliberately separate from the POS role. none = no admin panel at all. hq_admin = every store, full metrics and fleet hardware ops, but NOT Remote Workstation (taking over a live lane is a store-floor action). store_manager = their own store, everything. csm = their store, operational pages only, Remote Workstation limited to override tools. lp = Asset Protection / Loss Prevention: their store's LP workbench and the views feeding it, no config, no hardware, no lane takeover. technician = hardware, diagnostics and docs across their serviced stores, no people and no money. vendor = their own product line across every store that carries it. Blank = derived from the POS role so existing operators keep working."
    },
    "home_store_id": {
      "type": "string",
      "description": "Store number this person's admin access is anchored to \u2014 the single store a store_manager, csm or lp may see. Blank falls back to store_id."
    },
    "serviced_store_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Store numbers a technician services. Hardware problems do not respect store boundaries, so techs are region/cluster scoped rather than single-store: a list of one covers a dedicated in-store tech, and a list of every store covers a chain IT lead. Empty falls back to home_store_id / store_id."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "on_leave": {
      "type": "boolean",
      "default": false,
      "description": "True when the linked employee is on leave. Displayed as an On Leave badge in Operator Management. While on leave the operator status is set to inactive."
    },
    "email": {
      "type": "string"
    },
    "store_id": {
      "type": "string",
      "description": "Store number this operator is assigned to. Blank = unassigned (visible centrally)."
    },
    "pos_access": {
      "type": "boolean",
      "default": true,
      "description": "If false, this operator cannot log into the POS or approve POS overrides."
    },
    "company_id": {
      "type": "string",
      "description": "For vendor role: the Company ID this operator represents. Used to scope inventory and sales insights to only items tagged with this Company ID."
    }
  },
  "required": [
    "operator_id",
    "full_name",
    "pin",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}