{
  "name": "SCOAssistanceRequest",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Self-checkout lane that raised the request."
    },
    "store_id": {
      "type": "string",
      "description": "Store number of the lane."
    },
    "reason": {
      "type": "string",
      "enum": [
        "age_check",
        "recalled",
        "loss_blocked",
        "unscannable",
        "serialized",
        "attendant_help",
        "other"
      ],
      "description": "Why the lane locked. age_check = ID-required item scanned; recalled / loss_blocked = a blocked item was scanned (release-only, never approvable); unscannable = the code matched nothing; serialized = the item needs a serial captured by the attendant; attendant_help = the customer pressed the Help button."
    },
    "detail": {
      "type": "string",
      "description": "Free-text context (the code that failed to scan, etc.)."
    },
    "sku": {
      "type": "string",
      "description": "SKU of the item that triggered the request, when there is one."
    },
    "product_name": {
      "type": "string",
      "description": "Name of the item that triggered the request."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "released",
        "cancelled"
      ],
      "default": "pending",
      "description": "pending = lane is locked waiting for an attendant. approved = the attendant verified/authorized and the item continues into the sale. released = the lane resumes WITHOUT the item. cancelled = the customer withdrew a Help call."
    },
    "attendant_operator_id": {
      "type": "string",
      "description": "Operator who resolved the request."
    },
    "attendant_name": {
      "type": "string"
    },
    "resolved_via": {
      "type": "string",
      "enum": [
        "",
        "remote",
        "lane"
      ],
      "default": "",
      "description": "remote = approved from the attendant lane's panel; lane = the attendant walked over and keyed their PIN on the SCO lane's locked screen."
    },
    "serial_number": {
      "type": "string",
      "description": "Serial the attendant scanned/keyed at the lane for a serialized item. Only set on a walk-over approval of a serialized request."
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "register_id",
    "reason"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}