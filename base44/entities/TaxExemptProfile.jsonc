{
  "name": "TaxExemptProfile",
  "type": "object",
  "properties": {
    "tax_exempt_id": {
      "type": "string",
      "description": "Unique system-managed Tax Exempt ID (e.g. TE-XXXXXXXX)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "business",
        "individual"
      ],
      "default": "business",
      "description": "Whether the account holder is a business or an individual"
    },
    "name": {
      "type": "string",
      "description": "Business or individual full name"
    },
    "contact_name": {
      "type": "string"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tax_id_number": {
      "type": "string",
      "description": "Customer's EIN, SSN, or state tax ID number"
    },
    "exemption_type": {
      "type": "string",
      "enum": [
        "resale",
        "government",
        "nonprofit",
        "agricultural",
        "manufacturing",
        "other"
      ],
      "default": "resale"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Disabled accounts cannot verify at the POS"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the profile was created"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tax_exempt_id",
    "name",
    "exemption_type",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}