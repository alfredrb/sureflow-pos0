{
  "name": "CentralUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Unique central admin login ID"
    },
    "full_name": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "description": "Login PIN / password"
    },
    "role": {
      "type": "string",
      "enum": [
        "central_admin",
        "hq_manager",
        "regional_manager"
      ],
      "default": "central_admin",
      "description": "central_admin = all stores; regional_manager scoped to assigned_region; hq_manager = view-only oversight"
    },
    "email": {
      "type": "string"
    },
    "assigned_region": {
      "type": "string",
      "description": "Region this user oversees (empty/blank = all stores)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "pin",
    "role"
  ]
}