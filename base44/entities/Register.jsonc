{
  "name": "Register",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "maintenance"
      ],
      "default": "offline"
    },
    "ip_address": {
      "type": "string"
    },
    "subnet_mask": {
      "type": "string"
    },
    "gateway": {
      "type": "string"
    },
    "assigned_operator": {
      "type": "string"
    },
    "feature_returns": {
      "type": "boolean",
      "default": false,
      "description": "Enable Returns / Refunds on this register"
    },
    "feature_customer_service": {
      "type": "boolean",
      "default": false,
      "description": "Enable Customer Service Mode on this register"
    },
    "feature_exchange": {
      "type": "boolean",
      "default": false,
      "description": "Enable Item Exchange on this register"
    }
  },
  "required": [
    "register_id",
    "name"
  ]
}