{
  "name": "Register",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "maintenance"
      ],
      "default": "offline"
    },
    "ip_address": {
      "type": "string"
    },
    "subnet_mask": {
      "type": "string"
    },
    "gateway": {
      "type": "string"
    },
    "assigned_operator": {
      "type": "string"
    },
    "feature_returns": {
      "type": "boolean",
      "default": false,
      "description": "Enable Returns / Refunds on this register"
    },
    "feature_customer_service": {
      "type": "boolean",
      "default": false,
      "description": "Enable Customer Service Mode on this register"
    },
    "feature_exchange": {
      "type": "boolean",
      "default": false,
      "description": "Enable Item Exchange on this register"
    },
    "paused": {
      "type": "boolean",
      "default": false,
      "description": "Whether this register is paused (locked from use)"
    },
    "remote_logout_requested": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating a remote logout has been requested by admin"
    },
    "remote_logout_reason": {
      "type": "string",
      "description": "Reason for remote logout to display on POS"
    },
    "remote_logout_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the remote logout was requested (used for 10-minute auto-logout)"
    },
    "cash_limit": {
      "type": "number",
      "default": 5000,
      "description": "Maximum cash allowed in register drawer before audit required"
    },
    "printer_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "unknown"
      ],
      "default": "unknown",
      "description": "Receipt printer connectivity status"
    },
    "scanner_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "unknown"
      ],
      "default": "unknown",
      "description": "Barcode scanner connectivity status"
    },
    "printer_model": {
      "type": "string",
      "description": "Receipt printer make/model connected to this register"
    },
    "scanner_model": {
      "type": "string",
      "description": "Barcode scanner make/model connected to this register"
    },
    "cash_drawer_model": {
      "type": "string",
      "description": "Cash drawer make/model connected to this register"
    }
  },
  "required": [
    "register_id",
    "name"
  ]
}