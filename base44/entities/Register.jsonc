{
  "name": "Register",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "maintenance"
      ],
      "default": "offline"
    },
    "ip_address": {
      "type": "string"
    },
    "subnet_mask": {
      "type": "string"
    },
    "gateway": {
      "type": "string"
    },
    "assigned_operator": {
      "type": "string"
    },
    "feature_returns": {
      "type": "boolean",
      "default": false,
      "description": "Enable Returns / Refunds on this register"
    },
    "feature_customer_service": {
      "type": "boolean",
      "default": false,
      "description": "Enable Customer Service Mode on this register"
    },
    "feature_exchange": {
      "type": "boolean",
      "default": false,
      "description": "Enable Item Exchange on this register"
    },
    "paused": {
      "type": "boolean",
      "default": false,
      "description": "Whether this register is paused (locked from use)"
    },
    "remote_logout_requested": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating a remote logout has been requested by admin"
    },
    "remote_logout_reason": {
      "type": "string",
      "description": "Reason for remote logout to display on POS"
    },
    "remote_logout_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the remote logout was requested (used for 10-minute auto-logout)"
    },
    "cash_limit": {
      "type": "number",
      "default": 5000,
      "description": "Maximum cash allowed in register drawer before audit required"
    },
    "printer_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "unknown"
      ],
      "default": "unknown",
      "description": "Receipt printer connectivity status"
    },
    "scanner_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "unknown"
      ],
      "default": "unknown",
      "description": "Barcode scanner connectivity status"
    },
    "cash_drawer_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "unknown"
      ],
      "default": "unknown",
      "description": "Cash drawer connectivity status"
    },
    "printer_model": {
      "type": "string",
      "description": "Receipt printer make/model connected to this register"
    },
    "printer_ip": {
      "type": "string",
      "description": "Static LAN IP of this register's receipt printer (e.g. 192.168.1.60). The POS sends raw ESC/POS receipts and the cash-drawer kick to this address through the store's Local Relay VM on port 9100. Blank = the relay uses the first printer in its PRINTER_IPS list."
    },
    "scanner_model": {
      "type": "string",
      "description": "Barcode scanner make/model connected to this register (e.g. Zebra DS4308)"
    },
    "cash_drawer_model": {
      "type": "string",
      "description": "Cash drawer make/model connected to this register"
    },
    "printer_serial": {
      "type": "string",
      "description": "Receipt printer serial number"
    },
    "scanner_serial": {
      "type": "string",
      "description": "Barcode scanner serial number"
    },
    "cash_drawer_serial": {
      "type": "string",
      "description": "Cash drawer serial number"
    },
    "pinpad_model": {
      "type": "string",
      "enum": [
        "",
        "isc250",
        "lane_7000"
      ],
      "default": "",
      "description": "Customer-facing Ingenico pinpad attached to this lane. Selects the command profile the relay uses to drive it: isc250 = Ingenico iSC Touch 250 (supported today), lane_7000 = Ingenico Lane/7000 (profile reserved for a future rollout). Blank = no pinpad on this lane, and every pinpad prompt is skipped silently."
    },
    "pinpad_ip": {
      "type": "string",
      "description": "Static LAN IP of this lane's Ingenico pinpad (e.g. 192.168.1.70). The POS drives signature capture, customer prompts, gift-card entry, the cart mirror and the rating screen through the store's Local Relay VM on this address."
    },
    "pinpad_serial": {
      "type": "string",
      "description": "Pinpad serial number, for the hardware audit."
    },
    "pole_display_model": {
      "type": "string",
      "enum": [
        "",
        "epson_dmd110",
        "logic_ld9900"
      ],
      "default": "",
      "description": "Customer-facing pole display (line display) on this lane. Selects the command profile the relay uses: epson_dmd110 = Epson DM-D110 driven pass-through via the lane's receipt printer (supported today), logic_ld9900 = Logic Controls LD9900 over a serial-device server (profile reserved). Blank = no pole on this lane, and every display update is skipped silently."
    },
    "pole_display_ip": {
      "type": "string",
      "description": "LAN IP the relay writes pole display frames to. For the DM-D110 leave this blank \u2014 it hangs off the receipt printer's DM-D port and the relay routes through printer_ip. Only set for displays with their own network address (serial-device server)."
    },
    "pole_display_serial": {
      "type": "string",
      "description": "Pole display serial number, for the hardware audit."
    },
    "terminal_model": {
      "type": "string",
      "description": "POS terminal / computer make and model (e.g. IBM SurePOS 700, Elo EPS00E2)"
    },
    "terminal_serial": {
      "type": "string",
      "description": "POS terminal / computer serial number"
    },
    "mac_address": {
      "type": "string",
      "description": "Primary NIC MAC address of the terminal. Used as the hardware identity for PXE/diskless boot instead of a static IP."
    },
    "boot_profile": {
      "type": "string",
      "enum": [
        "pxe_debian_legacy",
        "pxe_debian_modern",
        "local_disk"
      ],
      "default": "local_disk",
      "description": "Which boot image the store's PXE controller serves this terminal. pxe_debian_legacy = IBM SurePOS 700 class hardware; pxe_debian_modern = Elo EPS00E2 class hardware; local_disk = terminal boots from its own disk."
    },
    "keyboard_model": {
      "type": "string",
      "description": "POS keyboard make/model (e.g. IBM 3AA01194300). Determines the udev/hwdb scancode mapping applied at boot."
    },
    "scanner_interface": {
      "type": "string",
      "enum": [
        "usb_hid",
        "rs232_serial",
        "usb_ocia",
        "unknown"
      ],
      "default": "usb_hid",
      "description": "How the barcode scanner attaches to the terminal. usb_hid = keyboard-wedge (Zebra DS4308 default); rs232_serial / usb_ocia = legacy IBM interfaces requiring extra driver setup."
    },
    "pxe_vlan": {
      "type": "string",
      "description": "VLAN ID carrying PXE/diskless boot traffic for this terminal (isolated from general store traffic)."
    },
    "backend_vlan": {
      "type": "string",
      "description": "VLAN ID carrying backend traffic (relay DB, sync, printing) for this terminal."
    },
    "store_id": {
      "type": "string",
      "description": "Store number this register belongs to. POS reads this to scope all data to the store."
    }
  },
  "required": [
    "register_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}