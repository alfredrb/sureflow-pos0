{
  "name": "StoreSettings",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "default": "Supermart"
    },
    "store_address": {
      "type": "string"
    },
    "store_phone": {
      "type": "string"
    },
    "store_email": {
      "type": "string"
    },
    "admin_printer_ip": {
      "type": "string",
      "description": "Static LAN IP of the printer the Admin site prints to (till check-in/out slips, cash slips, transaction reprints), reached through the store's Local Relay VM on port 9100. Blank = the relay uses the first printer in its PRINTER_IPS list."
    },
    "default_tax_rate": {
      "type": "number",
      "default": 7,
      "description": "Default sales tax percentage applied to new items"
    },
    "currency_symbol": {
      "type": "string",
      "default": "$"
    },
    "currency_code": {
      "type": "string",
      "default": "USD"
    },
    "decimal_places": {
      "type": "number",
      "default": 2
    },
    "tax_inclusive": {
      "type": "boolean",
      "default": false,
      "description": "Whether displayed prices already include tax"
    },
    "require_sod": {
      "type": "boolean",
      "default": true,
      "description": "Require Start of Day protocol before sales"
    },
    "return_period_days": {
      "type": "number",
      "default": 30,
      "description": "Default return window in days"
    },
    "default_cash_limit": {
      "type": "number",
      "default": 5000,
      "description": "Default cash limit for new registers"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 10,
      "description": "Stock level at which inventory alerts trigger"
    },
    "training_mode_default": {
      "type": "boolean",
      "default": false,
      "description": "Start new register sessions in training mode"
    },
    "require_override_pin": {
      "type": "boolean",
      "default": true,
      "description": "Require CSM/Manager PIN for function key overrides"
    },
    "enable_remote_logout": {
      "type": "boolean",
      "default": true,
      "description": "Allow admins to remotely log out operators"
    },
    "pos_key_paging_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, each POS function-key tab has two pages of nine slots and the last slot of the grid holds the Next Page / Previous Page key. When false, paging is off and every tab shows a single page using all nine slots."
    },
    "loyalty_points_percentage": {
      "type": "number",
      "default": 5,
      "description": "Percentage of the sale subtotal earned back as rewards credit (e.g. 5 = 5%)"
    },
    "no_receipt_return_limit": {
      "type": "number",
      "default": 0,
      "description": "Maximum no-receipt / manager-override returns a customer can make before being automatically blocked at the POS. 0 = no limit. The POS shows a visual warning at 75% and prints a cut-off notice on the receipt."
    },
    "lp_disabled_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Loss Prevention event categories excluded from High-Risk Events and the operator risk ranking (e.g. voids, price_override, id_verify, tax_exempt, loyalty, no_sale, refund, cash_request, robbery)."
    },
    "weekly_hours_budget": {
      "type": "number",
      "default": 0,
      "description": "Store-allocated weekly labor hour budget. Used by the AI scheduling recommendation to balance total scheduled hours against the budget cap. 0 = no cap."
    },
    "weekly_labor_budget": {
      "type": "number",
      "default": 0,
      "description": "Store-allocated weekly labor cost budget (dollars). The scheduling calendar labor-cost indicator turns red when the week's estimated pay exceeds this. 0 = no cap."
    },
    "overtime_threshold_hours": {
      "type": "number",
      "default": 40,
      "description": "Weekly hours after which an employee earns overtime. Used by payroll, the labor-cost indicator, and the AI scheduler."
    },
    "store_id": {
      "type": "string",
      "description": "Store number these settings apply to. Blank = global default settings."
    }
  },
  "required": [
    "store_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}