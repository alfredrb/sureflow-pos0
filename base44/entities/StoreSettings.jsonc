{
  "name": "StoreSettings",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "default": "Supermart"
    },
    "store_address": {
      "type": "string"
    },
    "store_phone": {
      "type": "string"
    },
    "store_email": {
      "type": "string"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 7,
      "description": "Default sales tax percentage applied to new items"
    },
    "currency_symbol": {
      "type": "string",
      "default": "$"
    },
    "currency_code": {
      "type": "string",
      "default": "USD"
    },
    "decimal_places": {
      "type": "number",
      "default": 2
    },
    "tax_inclusive": {
      "type": "boolean",
      "default": false,
      "description": "Whether displayed prices already include tax"
    },
    "require_sod": {
      "type": "boolean",
      "default": true,
      "description": "Require Start of Day protocol before sales"
    },
    "return_period_days": {
      "type": "number",
      "default": 30,
      "description": "Default return window in days"
    },
    "default_cash_limit": {
      "type": "number",
      "default": 5000,
      "description": "Default cash limit for new registers"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 10,
      "description": "Stock level at which inventory alerts trigger"
    },
    "training_mode_default": {
      "type": "boolean",
      "default": false,
      "description": "Start new register sessions in training mode"
    },
    "require_override_pin": {
      "type": "boolean",
      "default": true,
      "description": "Require CSM/Manager PIN for function key overrides"
    },
    "enable_remote_logout": {
      "type": "boolean",
      "default": true,
      "description": "Allow admins to remotely log out operators"
    },
    "loyalty_points_percentage": {
      "type": "number",
      "default": 5,
      "description": "Percentage of the sale subtotal earned back as rewards credit (e.g. 5 = 5%)"
    },
    "lp_show_voids": {
      "type": "boolean",
      "default": true,
      "description": "When false, voids are excluded from the Loss Prevention High-Risk Events list and operator risk ranking."
    },
    "lp_show_overrides": {
      "type": "boolean",
      "default": true,
      "description": "When false, price overrides are excluded from the Loss Prevention High-Risk Events list and operator risk ranking."
    },
    "lp_show_refunds": {
      "type": "boolean",
      "default": true,
      "description": "When false, refunds are excluded from the Loss Prevention High-Risk Events list and operator risk ranking."
    },
    "lp_show_no_sales": {
      "type": "boolean",
      "default": true,
      "description": "When false, no-sales are excluded from the Loss Prevention operator risk ranking."
    },
    "store_id": {
      "type": "string",
      "description": "Store number these settings apply to. Blank = global default settings."
    }
  },
  "required": [
    "store_name"
  ]
}