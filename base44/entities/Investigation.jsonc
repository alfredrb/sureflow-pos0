{
  "name": "Investigation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "cash_short",
        "cash_over",
        "voids",
        "overrides",
        "refunds",
        "no_sales",
        "stock_theft",
        "pattern",
        "other"
      ],
      "default": "other",
      "description": "Primary category of the investigation. stock_theft covers customer-related theft / shrinkage where specific items were stolen and should be deducted from inventory."
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "closed"
      ],
      "default": "open"
    },
    "operator_name": {
      "type": "string",
      "description": "Primary operator the investigation is about"
    },
    "operator_id": {
      "type": "string"
    },
    "linked_operators": {
      "type": "array",
      "description": "Additional operators attached to this investigation",
      "items": {
        "type": "object",
        "properties": {
          "operator_id": {
            "type": "string"
          },
          "operator_name": {
            "type": "string"
          }
        }
      }
    },
    "assigned_to": {
      "type": "string",
      "description": "Supervisor/operator currently assigned to the investigation"
    },
    "register_id": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "What is being investigated and why"
    },
    "amount_impact": {
      "type": "number",
      "default": 0,
      "description": "Estimated dollar exposure (auto-calculated from stolen items for stock_theft cases when left blank)"
    },
    "date_range_start": {
      "type": "string",
      "format": "date"
    },
    "date_range_end": {
      "type": "string",
      "format": "date"
    },
    "stolen_items": {
      "type": "array",
      "description": "Items stolen in a stock_theft investigation. Quantities are deducted from Product.stock_qty when the investigation is saved.",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "default": 1
          },
          "unit_cost": {
            "type": "number",
            "default": 0
          },
          "total_loss": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Linked events / audits / receipts / documents that support the investigation",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "document_title": {
            "type": "string",
            "description": "Title of the linked document (when type is document)"
          },
          "document_html": {
            "type": "string",
            "description": "Rendered HTML body of the linked document (when type is document)"
          }
        }
      }
    },
    "activity_log": {
      "type": "array",
      "description": "Append-only timeline of status changes and notes",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "True if the case was seeded from an AI suggestion"
    },
    "resolution": {
      "type": "string",
      "description": "Outcome once the investigation is closed"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "status"
  ]
}