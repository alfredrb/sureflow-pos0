{
  "name": "CustomerDisplayState",
  "type": "object",
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Lane this state belongs to. Exactly ONE record per register \u2014 the POS upserts it, the customer monitor subscribes to it. This is the transport: the monitor runs in a SEPARATE browser window from the POS, so React state cannot reach it and the live cart has to travel through a record."
    },
    "store_id": {
      "type": "string",
      "description": "Store number, so the monitor can pick the right idle slide rotation without a second lookup."
    },
    "mode": {
      "type": "string",
      "enum": [
        "idle",
        "sale",
        "thanks"
      ],
      "default": "idle",
      "description": "What the customer monitor should be showing. idle = the store's promotion rotation. sale = the live itemized cart. thanks = the post-tender summary, which holds briefly and then returns to idle."
    },
    "lane_phase": {
      "type": "string",
      "enum": [
        "",
        "welcome",
        "scanning",
        "paying",
        "thanks"
      ],
      "default": "",
      "description": "Where a SELF-CHECKOUT lane's customer actually is in the flow, published alongside mode. mode alone cannot tell scanning from paying \u2014 both are a live cart \u2014 so the attendant panel reads this to show PAYING while the customer is on the pay screen. Blank on a cashiered lane, which has no customer-driven phase."
    },
    "items": {
      "type": "array",
      "description": "The live cart as the customer should see it. Deliberately a trimmed projection of the POS cart \u2014 name, qty and line total only, no cost, margin or internal flags ever reach a customer-facing screen.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "prompt": {
      "type": "object",
      "additionalProperties": true,
      "description": "An OPEN REQUEST to the customer, drawn on top of whatever mode is showing and answered by the customer touching the panel. This is the web replacement for the Ingenico pinpad flows: the pad needs a signed Retail Base Application that these lanes do not have, whereas the customer monitor is already a touch panel the app fully controls. Blank/absent = the screen is read-only and has nothing to press, which is its normal state.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id for this request. The POS waits for a response carrying the SAME id, so a stale answer from an abandoned prompt can never be read as the answer to the current one."
        },
        "type": {
          "type": "string",
          "enum": [
            "confirm",
            "rating",
            "numeric",
            "signature"
          ],
          "description": "confirm = approve/decline an amount. rating = 1-5 satisfaction tap. numeric = customer keys a number (gift card, phone) on an on-screen keypad. signature = customer signs with a finger."
        },
        "title": {
          "type": "string",
          "description": "Large primary line the customer reads."
        },
        "subtitle": {
          "type": "string",
          "description": "Smaller supporting line under the title."
        },
        "amount": {
          "type": "number",
          "description": "Amount shown for a confirm prompt."
        },
        "min_length": {
          "type": "number",
          "description": "Fewest digits a numeric prompt accepts before its OK button enables."
        },
        "max_length": {
          "type": "number",
          "description": "Most digits a numeric prompt accepts."
        },
        "mask": {
          "type": "boolean",
          "default": false,
          "description": "Show the keyed digits as dots. For a number the customer would not want a queue behind them to read."
        },
        "allow_cancel": {
          "type": "boolean",
          "default": true,
          "description": "Whether the customer may back out themselves. False for prompts only an operator should clear."
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "description": "The customer's answer to the prompt with the matching id, written by the monitor window and read by the POS. Kept as its own field rather than overwriting the prompt so the POS can tell 'not answered yet' from 'answered'.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Echoes prompt.id. An answer whose id does not match the open prompt is ignored."
        },
        "type": {
          "type": "string"
        },
        "approved": {
          "type": "boolean",
          "description": "Confirm prompts: whether the customer accepted."
        },
        "rating": {
          "type": "number",
          "description": "Rating prompts: 1-5 as tapped."
        },
        "value": {
          "type": "string",
          "description": "Numeric prompts: the digits the customer keyed."
        },
        "signature_url": {
          "type": "string",
          "description": "Signature prompts: uploaded PNG of the drawing. A URL rather than the image itself \u2014 an inline data URL would be a large blob on every read of this record."
        },
        "cancelled": {
          "type": "boolean",
          "description": "The customer backed out instead of answering."
        },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "thanks": {
      "type": "object",
      "additionalProperties": true,
      "description": "Post-tender summary payload: total_paid, loyalty_points_earned, savings, change_due and a receipt note. Only populated while mode is thanks.",
      "properties": {
        "total_paid": {
          "type": "number"
        },
        "loyalty_points_earned": {
          "type": "number"
        },
        "loyalty_name": {
          "type": "string"
        },
        "savings": {
          "type": "number"
        },
        "change_due": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "training_mode": {
      "type": "boolean",
      "default": false,
      "description": "True when the lane is in training mode, so the monitor can mark itself as a training screen and a customer is never shown a practice sale as if it were real."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the POS last published. The monitor treats a very stale sale state as idle, so a lane whose POS window was closed mid-sale does not leave a customer's cart on screen indefinitely."
    }
  },
  "required": [
    "register_id"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}