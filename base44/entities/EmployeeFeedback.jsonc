{
  "name": "EmployeeFeedback",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Employee ID this record belongs to."
    },
    "operator_id": {
      "type": "string",
      "description": "Operator ID of the employee (for cross-referencing)."
    },
    "employee_name": {
      "type": "string",
      "description": "Employee full name at the time of the record."
    },
    "category": {
      "type": "string",
      "enum": [
        "praise",
        "feedback",
        "warning",
        "disciplinary",
        "recognition"
      ],
      "default": "feedback",
      "description": "Type of record: praise/recognition (positive), feedback (general), warning/disciplinary (corrective)."
    },
    "tier": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ],
      "description": "Disciplinary document tier. green = coaching, yellow = formal warning, red = serious action."
    },
    "template_type": {
      "type": "string",
      "description": "The standard template type used to generate this record (e.g. verbal_warning, written_warning, final_warning)."
    },
    "title": {
      "type": "string",
      "description": "Short title / summary of the record."
    },
    "situation": {
      "type": "string",
      "description": "SBI \u2014 Situation: when and where the incident occurred."
    },
    "behavior": {
      "type": "string",
      "description": "SBI \u2014 Behavior: what the employee did or failed to do."
    },
    "impact": {
      "type": "string",
      "description": "SBI \u2014 Impact: how the behavior affected the team, operation, or safety."
    },
    "follow_up": {
      "type": "string",
      "description": "Follow-up / next steps required."
    },
    "detail": {
      "type": "string",
      "description": "Full description of the feedback or disciplinary action (freeform)."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the event occurred."
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "action_taken": {
      "type": "string",
      "description": "Action taken or follow-up required."
    },
    "created_by": {
      "type": "string",
      "description": "Operator who created the record."
    }
  },
  "required": [
    "employee_id",
    "category",
    "title",
    "date"
  ]
}