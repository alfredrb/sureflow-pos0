{
  "name": "FunctionKey",
  "type": "object",
  "properties": {
    "key_number": {
      "type": "number"
    },
    "label": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "void_item",
        "abort_transaction",
        "void_cash_transaction",
        "void_transaction",
        "discount_item",
        "discount_total",
        "price_check",
        "no_sale",
        "subtotal",
        "tax_exempt",
        "price_override",
        "quantity",
        "repeat_last",
        "suspend",
        "resume",
        "refund",
        "reprint_receipt",
        "none"
      ],
      "default": "none",
      "description": "abort_transaction clears the in-progress sale before tender. void_cash_transaction pulls a COMPLETED cash sale back out of the books (manager approval, current shift only). void_transaction is the legacy name for abort_transaction and is kept so existing keys keep working."
    },
    "color": {
      "type": "string",
      "default": "#374151"
    },
    "requires_supervisor": {
      "type": "boolean",
      "default": false,
      "description": "Legacy field \u2014 use requires_role instead"
    },
    "requires_role": {
      "type": "string",
      "enum": [
        "none",
        "csm",
        "manager"
      ],
      "default": "none",
      "description": "Minimum role required to use this key without override"
    }
  },
  "required": [
    "key_number",
    "label",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}