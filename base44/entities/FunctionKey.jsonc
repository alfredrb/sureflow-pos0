{
  "name": "FunctionKey",
  "type": "object",
  "properties": {
    "key_number": {
      "type": "number"
    },
    "label": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "void_item",
        "abort_transaction",
        "void_cash_transaction",
        "void_transaction",
        "discount_item",
        "discount_total",
        "price_check",
        "no_sale",
        "subtotal",
        "tender_cash",
        "tender_check",
        "tender_credit",
        "tender_debit",
        "tender_store_credit",
        "tender_giftcard",
        "tax_exempt",
        "price_override",
        "quantity",
        "repeat_last",
        "suspend",
        "resume",
        "refund",
        "reprint_receipt",
        "register_tender_reading",
        "eod_summary",
        "none"
      ],
      "default": "none",
      "description": "abort_transaction clears the in-progress sale before tender. void_cash_transaction pulls a COMPLETED cash sale back out of the books (manager approval, current shift only). void_transaction is the legacy name for abort_transaction and is kept so existing keys keep working. The tender_* actions are the 4690 one-touch tender keys: subtotal totals the sale, the operator keys an amount (or nothing for the full balance), and a tender key commits that amount on that tender \u2014 under-tendering simply leaves a balance for the next tender key, which is how split tender happens. tender_check routes through the cheque station (MICR read + franking) and tender_giftcard opens the gift-card balance check. register_tender_reading prompts for a register and prints its SOD / current / EOD tender reading slip. eod_summary mirrors the store's consolidated end-of-day summary onto the customer pinpad and prints it."
    },
    "color": {
      "type": "string",
      "default": "#374151"
    },
    "requires_supervisor": {
      "type": "boolean",
      "default": false,
      "description": "Legacy field \u2014 use requires_role instead"
    },
    "requires_role": {
      "type": "string",
      "enum": [
        "none",
        "csm",
        "manager"
      ],
      "default": "none",
      "description": "Minimum role required to use this key without override"
    }
  },
  "required": [
    "key_number",
    "label",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}